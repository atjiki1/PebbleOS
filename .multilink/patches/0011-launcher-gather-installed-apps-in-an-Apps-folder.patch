+static void prv_folder_update_row(LauncherAppWindowData *data) {
+  const bool has_apps = (app_menu_data_source_get_count(&data->folder_data_source) > 0);
+  launcher_menu_layer_set_folder_row(&data->launcher_menu_layer,
